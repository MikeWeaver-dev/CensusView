values    = dom,
title     = legend_title,
opacity   = 0.6,
na.label  = "",
layerId   = "legend",
labFormat = function(type, cuts, p) labs
)
})
# hide the note only after the browser added the new vector layer
observeEvent(input$map_drawn, {
shinyjs::hide("loading_note")
})
}
